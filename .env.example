# ==========================================
# CONFIGURACIÓN GENERAL PARA DOCKER & VPS
# ==========================================

# Puerto público donde escuchará la aplicación web (por defecto 80 HTTP)
WEB_PORT=80

# URL de la API (opcional). 
# Déjalo vacío si Nginx actúa como reverse proxy en el mismo dominio o IP.
VITE_API_URL=

# ==========================================
# BASE DE DATOS (POSTGRESQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave_segura_2026
POSTGRES_DB=eddam_overlay_studio

# ==========================================
# AUTENTICACIÓN JWT
# ==========================================
JWT_SECRET=super_clave_secreta_jwt_de_al_menos_32_caracteres_2026

# ==========================================
# ENVÍO DE CORREOS (RECUPERACIÓN DE CONTRASEÑA)
# ==========================================
# Opción 1: Resend (Recomendado por HTTPS puerto 443 - sin bloqueos de puertos VPS)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Opción 2: Servidor SMTP tradicional (Gmail, Zoho, Outlook, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
